<Application x:Class="IndoTweaks.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IndoTweaks.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
               <ResourceDictionary Source="pack://application:,,,/IndoTweaks;component/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <helpers:TweakStateToBrushConverter x:Key="TweakStateToBrushConverter"/>
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
