<UserControl x:Class="IndoTweaks.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Tweaks &amp; Optimizations" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left"/>
            <Button Content="Rescan All" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Command="{Binding RefreshStatesCommand}"/>
        </Grid>

        <Border DockPanel.Dock="Top" Background="#332A1F0E" BorderBrush="{StaticResource StatusWarnBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="⚠ Not running as Administrator - tweaks are disabled. Restart IndoTweaks as Admin to apply changes."
                       Foreground="{StaticResource StatusWarnBrush}" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tweaks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" Margin="0,4,14,0" VerticalAlignment="Top"
                                         Fill="{Binding State, Converter={StaticResource TweakStateToBrushConverter}}"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,4,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding EstimatedFpsGain, StringFormat=Up to +{0} FPS}" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding EstimatedLatencyReductionMs, StringFormat=Up to -{0}ms latency}" FontSize="11"
                                                   Foreground="{StaticResource AccentBrush2}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastActionLog}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="Apply" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Width="110"
                                            Command="{Binding DataContext.ApplyTweakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                                    <Button Content="Revert" Style="{StaticResource SecondaryButton}" Width="110"
                                            Command="{Binding DataContext.RevertTweakCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
